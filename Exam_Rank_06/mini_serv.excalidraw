   "versionNonce": 2061,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1753600000000,
   "link": null,
   "locked": false,
   "text": "\u00b7 one event per select() \u2192 a few extra syscalls,\n  buys: fd-sets can never go stale mid-sweep\n\u00b7 102 MB virtual reservation, tiny resident set\n\u00b7 msg block never freed \u2014 still-reachable by design\n  (server has no exit path \u00b7 valgrind: 0 bytes lost)\n\u00b7 Norm shaped the API: 5 fns \u00b7 \u226425 lines \u00b7 \u22644 params",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u00b7 one event per select() \u2192 a few extra syscalls,\n  buys: fd-sets can never go stale mid-sweep\n\u00b7 102 MB virtual reservation, tiny resident set\n\u00b7 msg block never freed \u2014 still-reachable by design\n  (server has no exit path \u00b7 valgrind: 0 bytes lost)\n\u00b7 Norm shaped the API: 5 fns \u00b7 \u226425 lines \u00b7 \u22644 params",
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 113
  }
