   "isDeleted": false,
   "boundElements": null,
   "updated": 1753600000000,
   "link": null,
   "locked": false,
   "text": "\u00b7 line > 100 000 chars would overflow its row\n  (tester never does \u00b7 upgrade: realloc-grow)\n\u00b7 fd \u2265 1024 unsupported \u2014 FD_SETSIZE is select()'s\n  own hard limit\n\u00b7 lazy client misses messages while its pipe is full\n  (subject bans disconnecting; queuing = unbounded RAM)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\u00b7 line > 100 000 chars would overflow its row\n  (tester never does \u00b7 upgrade: realloc-grow)\n\u00b7 fd \u2265 1024 unsupported \u2014 FD_SETSIZE is select()'s\n  own hard limit\n\u00b7 lazy client misses messages while its pipe is full\n  (subject bans disconnecting; queuing = unbounded RAM)",
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 113
  },
