   "versionNonce": 2056,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1753600000000,
   "link": null,
   "locked": false,
   "text": "1 sprintf per line \u00b7 1 send per ready peer\nid[] and msg[] indexed by fd \u2192 O(1) lookup,\nthe fd IS the hash.\nselect gates every recv/send \u2192 never\nblocks, never busy-waits, never EAGAIN",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1 sprintf per line \u00b7 1 send per ready peer\nid[] and msg[] indexed by fd \u2192 O(1) lookup,\nthe fd IS the hash.\nselect gates every recv/send \u2192 never\nblocks, never busy-waits, never EAGAIN",
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 94
  },
  {
