  {
   "id": "el59",
   "type": "text",
   "x": 76,
   "y": 1153,
   "width": 521,
   "height": 118,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
