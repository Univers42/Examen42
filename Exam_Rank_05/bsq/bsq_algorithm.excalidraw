      "seed": 932772993,
      "version": 2,
      "versionNonce": 871654649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788357627752,
      "link": null,
      "locked": false,
      "text": "up   = dp[j + 1];                        /* inner loop of bsq.c */\nif (map[i][j] == empty) {\n    v = 1 + min(up, dp[j], diag);\n    dp[j + 1] = v;\n    if (v > best) { best = v; br = i; bc = j; }\n} else\n    dp[j + 1] = 0;\ndiag = up;",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 136.5,
      "containerId": null,
      "originalText": "up   = dp[j + 1];                        /* inner loop of bsq.c */\nif (map[i][j] == empty) {\n    v = 1 + min(up, dp[j], diag);\n    dp[j + 1] = v;\n    if (v > best) { best = v; br = i; bc = j; }\n} else\n    dp[j + 1] = 0;\ndiag = up;",
      "lineHeight": 1.25,
      "index": "bBR",
      "autoResize": true
    },
