      "seed": 726990715,
      "version": 2,
      "versionNonce": 1015964887,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788357627752,
      "link": null,
      "locked": false,
      "text": "obstacle    →  dp = 0   (no square ends here)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "obstacle    →  dp = 0   (no square ends here)",
      "lineHeight": 1.25,
      "index": "b14",
      "autoResize": true
    },
    {
      "id": "85l8d7ceda0ioeja",
      "type": "text",
      "x": 245.6,
      "y": 612,
      "width": 646.8,
      "height": 35,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 939393837,
      "version": 2,
      "versionNonce": 1704474649,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788357627752,
      "link": null,
      "locked": false,
      "text": "why min? a k×k square ending here needs the three overlapping (k−1)×(k−1)\nsquares ending up / left / diag to exist — the worst neighbour caps the size.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 31.5,
      "containerId": null,
      "originalText": "why min? a k×k square ending here needs the three overlapping (k−1)×(k−1)\nsquares ending up / left / diag to exist — the worst neighbour caps the size.",
      "lineHeight": 1.25,
      "index": "b15",
      "autoResize": true
    },
    {
      "id": "xd45ba890ab7r8sb",
      "type": "text",
      "x": 100,
      "y": 700,
      "width": 567,
      "height": 56.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1849297833,
      "version": 2,
      "versionNonce": 154776055,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788357627752,
      "link": null,
      "locked": false,
      "text": "(1,1):  1 + min(1,1,1) = 2   ← all three allow it\n(2,2):  1 + min(2,0,2) = 1   ← a 0 neighbour (obstacle) caps it\n(2,7):  1 + min(2,2,2) = 3   ← all three allow it",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 52.5,
      "containerId": null,
      "originalText": "(1,1):  1 + min(1,1,1) = 2   ← all three allow it\n(2,2):  1 + min(2,0,2) = 1   ← a 0 neighbour (obstacle) caps it\n(2,7):  1 + min(2,2,2) = 3   ← all three allow it",
      "lineHeight": 1.25,
      "index": "b16",
      "autoResize": true
    },
