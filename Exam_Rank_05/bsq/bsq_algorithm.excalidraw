    },
    {
      "id": "sjmvoyp59vq553kw",
      "type": "text",
      "x": 245.6,
      "y": 576,
      "width": 459,
      "height": 21.2,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
