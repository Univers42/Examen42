   "roundness": null,
   "seed": 726990715,
   "version": 1,
   "versionNonce": 601117292,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1753600000000,
   "link": null,
   "locked": false,
   "text": "obstacle    \u2192  dp = 0   (no square ends here)",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 17.0,
   "containerId": null,
   "originalText": "obstacle    \u2192  dp = 0   (no square ends here)",
   "lineHeight": 1.25
  },
  {
   "id": "85l8d7ceda0ioeja",
   "type": "text",
   "x": 245.6,
   "y": 612,
   "width": 646.8,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 939393837,
   "version": 1,
   "versionNonce": 1958546580,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1753600000000,
   "link": null,
   "locked": false,
   "text": "why min? a k\u00d7k square ending here needs the three overlapping (k\u22121)\u00d7(k\u22121)\nsquares ending up / left / diag to exist \u2014 the worst neighbour caps the size.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 31.5,
   "containerId": null,
   "originalText": "why min? a k\u00d7k square ending here needs the three overlapping (k\u22121)\u00d7(k\u22121)\nsquares ending up / left / diag to exist \u2014 the worst neighbour caps the size.",
   "lineHeight": 1.25
  },
  {
   "id": "xd45ba890ab7r8sb",
   "type": "text",
   "x": 100,
   "y": 700,
   "width": 567.0,
   "height": 56.2,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1849297833,
   "version": 1,
   "versionNonce": 769945234,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1753600000000,
   "link": null,
   "locked": false,
   "text": "(1,1):  1 + min(1,1,1) = 2   \u2190 all three allow it\n(2,2):  1 + min(2,0,2) = 1   \u2190 a 0 neighbour (obstacle) caps it\n(2,7):  1 + min(2,2,2) = 3   \u2190 all three allow it",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 52.5,
   "containerId": null,
   "originalText": "(1,1):  1 + min(1,1,1) = 2   \u2190 all three allow it\n(2,2):  1 + min(2,0,2) = 1   \u2190 a 0 neighbour (obstacle) caps it\n(2,7):  1 + min(2,2,2) = 3   \u2190 all three allow it",
   "lineHeight": 1.25
  },
  {
   "id": "gg7jpm7qwrzfxz3p",
   "type": "text",
   "x": 60,
   "y": 784,
   "width": 804.0,
   "height": 25.0,
   "angle": 0,
   "strokeColor": "#1971c2",
