   "updated": 1753600000000,
   "link": null,
   "locked": false,
   "text": "top  = br \u2212 best + 1 = 2 \u2212 3 + 1 = 0\nleft = bc \u2212 best + 1 = 7 \u2212 3 + 1 = 5\nfill 3\u00d73 cells with 'x' \u2026 and print",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 52.5,
   "containerId": null,
   "originalText": "top  = br \u2212 best + 1 = 2 \u2212 3 + 1 = 0\nleft = bc \u2212 best + 1 = 7 \u2212 3 + 1 = 5\nfill 3\u00d73 cells with 'x' \u2026 and print",
   "lineHeight": 1.25
  },
