      "updated": 1788357627752,
      "link": null,
      "locked": false,
      "text": "top  = br − best + 1 = 2 − 3 + 1 = 0\nleft = bc − best + 1 = 7 − 3 + 1 = 5\nfill 3×3 cells with 'x' … and print",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 52.5,
      "containerId": null,
      "originalText": "top  = br − best + 1 = 2 − 3 + 1 = 0\nleft = bc − best + 1 = 7 − 3 + 1 = 5\nfill 3×3 cells with 'x' … and print",
      "lineHeight": 1.25,
      "index": "bBU",
