  {
   "id": "390xtnzj4g82t0dm",
   "type": "text",
   "x": 100,
   "y": 1768,
   "width": 554.4,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
