   "text": "empty cell  \u2192  dp = 1 + min(up, left, diag)",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 17.0,
   "containerId": null,
   "originalText": "empty cell  \u2192  dp = 1 + min(up, left, diag)",
