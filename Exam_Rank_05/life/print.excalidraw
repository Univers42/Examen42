   "boundElements": null,
   "updated": 1722000000000,
   "link": null,
   "locked": false,
   "text": "for (i = 0; i < b.w * b.h; i++)\n{\n  putchar(b.cells[i] ? 'O' : ' ');\n  if (i % b.w == b.w - 1)\n    putchar('\\n');\n}",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "for (i = 0; i < b.w * b.h; i++)\n{\n  putchar(b.cells[i] ? 'O' : ' ');\n  if (i % b.w == b.w - 1)\n    putchar('\\n');\n}",
   "autoResize": true,
   "lineHeight": 1.25
  },
