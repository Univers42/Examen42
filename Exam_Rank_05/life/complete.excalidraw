      "isDeleted": false,
      "boundElements": [],
      "updated": 1785142644331,
      "link": null,
      "locked": false,
      "text": "for (i = 0; i < 16; i++)  →  nb(&b, i%4, i/4) counts each cell's live neighbours:",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for (i = 0; i < 16; i++)  →  nb(&b, i%4, i/4) counts each cell's live neighbours:",
